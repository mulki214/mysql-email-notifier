# Brevo Transactional Email API v3. Never commit real credentials.
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
FROM_EMAIL=verified-sender@example.com
FROM_NAME=Gigel Account Notification

# Local MariaDB connection. Password belongs in .my.cnf, not here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=email_notifier
DB_NAME=db_gigel_prod
DB_DEFAULTS_FILE=/home/workspace/mysql-email-notifier/.my.cnf

POLL_SECONDS=5
MAX_ATTEMPTS=8
