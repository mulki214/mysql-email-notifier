# MySQL VPS settings. Do not use root; grant only SELECT on the source table
# and SELECT/UPDATE on email_notification_queue to this worker account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=email_notifier
DB_PASSWORD=REPLACE_WITH_SECRET

# Brevo SMTP settings from the activated Brevo account.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
FROM_EMAIL=verified-sender@example.com
FROM_NAME=Gigel Account Notification

POLL_SECONDS=5
MAX_ATTEMPTS=8
LOG_LEVEL=INFO
